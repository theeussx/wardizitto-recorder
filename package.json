{
  "name": "discord-recorder",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"bot,dash\" -c \"cyan,magenta\" \"npm run dev:bot\" \"npm run dev:dash\"",
    "dev:bot": "nodemon --exec ts-node src/index.ts",
    "dev:dash": "vite --config dashboard/vite.config.ts --root dashboard",
    "build": "npm run build:bot && npm run build:dash",
    "build:bot": "tsc",
    "build:dash": "vite build --config dashboard/vite.config.ts --root dashboard",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "mysql2": "^3.22.4",
    "prism-media": "^1.3.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.9.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
